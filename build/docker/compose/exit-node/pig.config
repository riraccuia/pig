# Replace this block before running. Generate a baseline with:
#   pig -c ... -to-cfg toml
#   pig -l ... -to-cfg toml

stun_global = "stun.mixvoip.com:3478"

[mqtt_global]
address = "ssl://broker.hivemq.com:8883"

[log]
file = "/var/log/pig/pig.log"
level = "info"
rotate_size = "1m"

[adapter]
tunnel_address = ["172.31.254.1/29", "fd8c:0a47:f698::/64"]

[[tunnels]]
name = "example"
direction = "listen"
proto = "."

[tunnels.tls]
insecure = true

[tunnels.listen]
address = "0.0.0.0"

[tunnels.ice]
enabled = true

[tunnels.ice.signaling]
id = "replace-me"
